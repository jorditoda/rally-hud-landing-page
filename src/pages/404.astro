---
import Layout from "Layout.astro";
import NotFoundPage from "@modules/notFound";
import defaultTemplateConfig from "utils/config";
import esTemplateConfig from "utils/config.es";
---

<Layout
  {...defaultTemplateConfig}
  seo={{
    title: "Page not found — Rally Hud",
    description: "That page does not exist. Head back to the Rally Hud home page.",
  }}
  noindex
>
  <!-- Shared app links (/s/{code}, /r/{id}, /seg/{id}, /rally/{code}) are served by this page: hide the
       "not found" text until React renders the right content. -->
  <script is:inline>
    if (/^\/(?:es\/)?(?:s|r|seg|rally)\/[^/]+\/?$/.test(location.pathname)) {
      document.documentElement.classList.add("shared-link");
    }
  </script>
  <style is:global>
    html.shared-link .not-found { visibility: hidden; }
  </style>
  <NotFoundPage client:load config={defaultTemplateConfig} configEs={esTemplateConfig} />
</Layout>
